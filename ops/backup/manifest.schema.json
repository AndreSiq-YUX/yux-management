{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.yux.com.br/schemas/backup-manifest-v1.json",
  "title": "YUX Hub backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "backupId",
    "createdAt",
    "targetRpoSeconds",
    "targetRtoSeconds",
    "commit",
    "images",
    "migrationVersions",
    "databaseArtifact",
    "volumeArtifacts",
    "secretCustodyReference",
    "restoreExternalEffectsEnabled"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "backupId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{5,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "targetRpoSeconds": { "type": "integer", "minimum": 1 },
    "targetRtoSeconds": { "type": "integer", "minimum": 1 },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "reference", "digest"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "migrationVersions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "databaseArtifact": { "$ref": "#/$defs/artifact" },
    "volumeArtifacts": {
      "type": "array",
      "minItems": 4,
      "allOf": [
        { "contains": { "type": "object", "properties": { "assetClass": { "const": "materials" } }, "required": ["assetClass"] } },
        { "contains": { "type": "object", "properties": { "assetClass": { "const": "company-knowledge" } }, "required": ["assetClass"] } },
        { "contains": { "type": "object", "properties": { "assetClass": { "const": "omnichannel-attachments" } }, "required": ["assetClass"] } },
        { "contains": { "type": "object", "properties": { "assetClass": { "const": "redis-aof" } }, "required": ["assetClass"] } }
      ],
      "items": {
        "allOf": [
          { "$ref": "#/$defs/artifact" },
          {
            "type": "object",
            "required": ["assetClass"],
            "properties": {
              "assetClass": {
                "enum": ["materials", "company-knowledge", "omnichannel-attachments", "redis-aof"]
              }
            }
          }
        ]
      }
    },
    "secretCustodyReference": {
      "type": "string",
      "minLength": 3,
      "not": { "pattern": "([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy])=" }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "windowStartedAt", "windowEndedAt"],
      "properties": {
        "mode": { "enum": ["quiesced", "snapshot-coordinated"] },
        "windowStartedAt": { "type": "string", "format": "date-time" },
        "windowEndedAt": { "type": "string", "format": "date-time" }
      }
    },
    "restoreExternalEffectsEnabled": { "const": false }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteSize", "sha256"],
      "properties": {
        "assetClass": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
