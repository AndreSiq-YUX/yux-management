NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://yux_app:yux_app_password@yux-postgres:5432/yux_hub
MIGRATOR_DATABASE_URL=postgresql://yux_migrator:<provisioned-outside-git>@yux-postgres:5432/yux_hub
YUX_API_DATABASE_URL=postgresql://yux_api:<provisioned-outside-git>@yux-postgres:5432/yux_hub
YUX_WORKER_DATABASE_URL=postgresql://yux_worker:<provisioned-outside-git>@yux-postgres:5432/yux_hub
YUX_RUNTIME_DATABASE_URL=postgresql://yux_runtime:<provisioned-outside-git>@yux-postgres:5432/yux_hub
YUX_DATABASE_SERVICE_ROLE=api
REDIS_URL=redis://yux-redis:6379
REDIS_PASSWORD=development-only-redis-password-change-in-production
YUX_WORKER_QUEUE_CLASS=all
YUX_INTERACTIVE_CONCURRENCY=2
YUX_INGESTION_CONCURRENCY=1
YUX_EXTERNAL_CONCURRENCY=2
YUX_MAINTENANCE_CONCURRENCY=1
YUX_DRAIN_LEGACY_QUEUE=true
YUX_SCHEDULER_ENABLED=true
SESSION_COOKIE_NAME=yux_session
SESSION_SECRET=development-only-session-secret-with-64-characters-change-in-production
CORS_ORIGIN=https://hub.yux.com.br
PUBLIC_APP_URL=https://hub.yux.com.br
YUX_AGENT_RUNTIME_URL=http://yux-agent-harness-runtime:8080
YUX_AGENT_RUNTIME_TOKEN=development-only-runtime-token-change-in-production
ACTION_ENGINE_MUTATION_LEASE_SECRET=development-only-mutation-lease-secret-change-in-production
ACTION_ENGINE_TELEMETRY_REDACTION_KEY=development-only-telemetry-redaction-key-change-in-production
MISSION_SUPERVISOR_ENABLED=true
MISSION_CONVERSATIONS_ENABLED=false
MISSION_CONVERSATIONS_TENANT_ALLOWLIST=
MISSION_CONVERSATIONS_MAX_TURNS=6
MISSION_CONVERSATIONS_POLL_MAX_SECONDS=5
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024
JINA_REQUEST_TIMEOUT_MS=15000
KNOWLEDGE_CURATION_MODEL=openai/gpt-4.1-mini
KNOWLEDGE_CURATION_ENABLED=true
KNOWLEDGE_CURATION_MAX_BATCH_CHARS=12000
KNOWLEDGE_WEBSITE_MAX_PAGES=10
PROVIDER_SECRET_ENCRYPTION_KEY_B64=<base64-of-exactly-32-random-bytes>
META_APP_ID=
META_APP_SECRET=
META_MARKETING_OAUTH_REDIRECT_URI=https://hub.yux.com.br/oauth/meta/callback
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
OAUTH_ALLOWED_REDIRECT_URIS=https://hub.yux.com.br/oauth/meta/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MARKETING_OAUTH_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
N8N_CRM_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
SMTP2GO_WEBHOOK_SECRET=
KNOWLEDGE_STORAGE_DIR=/app/storage/company-knowledge
STRATEGY_INGESTION_MAX_MB=150
