{
  "name": "yux-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "generate:mission-contracts": "tsx scripts/generate-mission-wire-types.ts",
    "migrate": "tsx scripts/apply-migrations.ts",
    "migrate:prod": "node dist/scripts/apply-migrations.js",
    "create-admin:prod": "node dist/scripts/create-admin-user.js",
    "reencrypt-provider-secrets": "tsx scripts/reencrypt-provider-secrets.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "ajv": "^8.20.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^22.0.1",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "sanitize-html": "^2.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
