{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YUX Strategy Concept Card",
  "type": "object",
  "required": [
    "concept",
    "category",
    "sourceScope",
    "visibility",
    "problemSolved",
    "triggerSignals",
    "diagnosisQuestions",
    "decisionRules",
    "antiPatterns",
    "recommendedActions",
    "allowedAgentProfileKeys",
    "stageTags",
    "retrievalTags",
    "yuxModules",
    "requiresHumanReview"
  ],
  "properties": {
    "concept": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "sourceScope": { "type": "string", "enum": ["internal", "client", "public", "system"] },
    "visibility": { "type": "string", "enum": ["internal_only", "client_safe"] },
    "problemSolved": { "type": "string" },
    "triggerSignals": { "type": "array", "items": { "type": "string" } },
    "diagnosisQuestions": { "type": "array", "items": { "type": "string" } },
    "decisionRules": { "type": "array", "items": { "type": "string" } },
    "antiPatterns": { "type": "array", "items": { "type": "string" } },
    "recommendedActions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowedAgentProfileKeys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stageTags": { "type": "array", "items": { "type": "string" } },
    "retrievalTags": { "type": "array", "items": { "type": "string" } },
    "yuxModules": { "type": "array", "items": { "type": "string" } },
    "requiresHumanReview": { "type": "boolean" },
    "sourceDocumentHash": { "type": "string" },
    "sourceChunkHash": { "type": "string" },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
